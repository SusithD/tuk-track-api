        {
          "name": "Vehicle history (last 7 days, page 1)",
          "description": "Pulls historical pings within a window. Default is last 24 hours; max is 7 days. The pre-request script below builds a 7-day window dynamically.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const to = new Date().toISOString();",
                  "const from = new Date(Date.now() - 7*24*3600*1000 + 60_000).toISOString();",
                  "pm.variables.set('history_from', from);",
                  "pm.variables.set('history_to', to);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/vehicles/{{vehicle_id}}/history?from={{history_from}}&to={{history_to}}&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vehicles", "{{vehicle_id}}", "history"],
              "query": [
                { "key": "from", "value": "{{history_from}}" },
                { "key": "to", "value": "{{history_to}}" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
