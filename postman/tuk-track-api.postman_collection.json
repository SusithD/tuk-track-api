        {
          "name": "Get device by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/devices/{{device_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "devices", "{{device_id}}"]
            }
          }
        },
        {
          "name": "Provision NEW device — captures key_id + secret",
          "description": "Provisions a fresh tracker on `vehicle_id`. The pre-request flow expects a vehicle in the env. The response contains `data.credentials.key_id` and `data.credentials.hmac_secret` — these are saved to the environment and used to sign device-side ping requests.\n\n**The plaintext secret is shown ONCE and cannot be recovered later.**",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 + credentials returned', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const c = pm.response.json().data.credentials;",
                  "  pm.expect(c.key_id).to.match(/^dev_/);",
                  "  pm.expect(c.hmac_secret).to.be.a('string');",
                  "  pm.environment.set('device_key_id', c.key_id);",
                  "  pm.environment.set('device_hmac_secret', c.hmac_secret);",
                  "  pm.environment.set('device_id', pm.response.json().data.device.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": \"{{vehicle_id}}\",\n  \"revoke_existing\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/devices",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "devices"]
            }
          }
        }
      ]
