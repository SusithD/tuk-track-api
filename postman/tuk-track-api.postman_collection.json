    {
      "name": "🛰 Tracking (Device Ingest — HMAC signed)",
      "description": "Requests in this folder use a folder-level pre-request script that signs each request using HMAC-SHA256 with the device's key_id + hmac_secret captured from `Devices Admin → Provision NEW device`.\n\n**Workflow:**\n1. Run `Vehicles → List vehicles` to capture `{{vehicle_id}}`\n2. Run `Devices Admin → Provision NEW device` to capture `{{device_key_id}}` + `{{device_hmac_secret}}`\n3. Run any request in this folder — headers `x-key-id`, `x-timestamp`, `x-nonce`, `x-signature` are added automatically",
      "auth": { "type": "noauth" },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// HMAC-SHA256 request signing for tracking devices.",
              "// Mirrors src/utils/hmac.js on the server.",
              "const keyId  = pm.environment.get('device_key_id');",
              "const secret = pm.environment.get('device_hmac_secret');",
              "if (!keyId || !secret) {",
              "  throw new Error('Run Devices Admin → Provision NEW device first to capture credentials.');",
              "}",
              "",
              "const ts    = Math.floor(Date.now() / 1000);",
              "const nonce = pm.variables.replaceIn('{{$randomUUID}}').replace(/-/g, '').slice(0, 16);",
              "",
              "const method = pm.request.method.toUpperCase();",
              "// Resolve the URL path with variables substituted.",
              "const fullUrl = pm.variables.replaceIn(pm.request.url.toString());",
              "const path    = new URL(fullUrl).pathname;",
              "",
              "// Body must be the raw JSON, not Postman's structured form.",
              "const body = pm.request.body && pm.request.body.raw ? pm.variables.replaceIn(pm.request.body.raw) : '';",
              "",
              "const bodyHash = CryptoJS.SHA256(body).toString(CryptoJS.enc.Hex);",
              "const signingString = `${ts}\\n${nonce}\\n${method}\\n${path}\\n${bodyHash}`;",
              "const signature     = CryptoJS.HmacSHA256(signingString, secret).toString(CryptoJS.enc.Hex);",
              "",
              "pm.request.headers.upsert({ key: 'x-key-id',    value: keyId });",
              "pm.request.headers.upsert({ key: 'x-timestamp', value: String(ts) });",
              "pm.request.headers.upsert({ key: 'x-nonce',     value: nonce });",
              "pm.request.headers.upsert({ key: 'x-signature', value: signature });",
              "console.log('Signed request:', { keyId, ts, nonce, signingString, signature });"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Submit single ping",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Inject a fresh recorded_at = now into the body before signing.",
                  "const recorded = new Date().toISOString();",
                  "pm.variables.set('recorded_at', recorded);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 6.9271,\n  \"lng\": 79.8612,\n  \"speed_kmh\": 25.5,\n  \"heading_deg\": 180,\n  \"recorded_at\": \"{{recorded_at}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/devices/pings",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "devices", "pings"]
            }
          }
        },
        {
          "name": "Submit batch (3 pings)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = Date.now();",
                  "pm.variables.set('rec_a', new Date(now - 120_000).toISOString());",
                  "pm.variables.set('rec_b', new Date(now -  60_000).toISOString());",
                  "pm.variables.set('rec_c', new Date(now).toISOString());"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pings\": [\n    { \"lat\": 6.9271, \"lng\": 79.8612, \"speed_kmh\":  0,   \"recorded_at\": \"{{rec_a}}\" },\n    { \"lat\": 6.9300, \"lng\": 79.8650, \"speed_kmh\": 18.4, \"recorded_at\": \"{{rec_b}}\" },\n    { \"lat\": 6.9320, \"lng\": 79.8680, \"speed_kmh\": 22.1, \"recorded_at\": \"{{rec_c}}\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/devices/pings",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "devices", "pings"]
            }
          }
        },
        {
          "name": "Submit ping with TAMPERED body (expects 401)",
          "description": "Send the same request, but the pre-request script signs the original body and we then 'tamper' by editing the body in the request — should return 401 DEVICE_SIGNATURE_INVALID. Manually edit lat/lng below to demonstrate.",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 6.9271,\n  \"lng\": 79.8612,\n  \"recorded_at\": \"2026-05-02T11:30:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/devices/pings",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "devices", "pings"]
            }
          }
        }
      ]
    }
  ]
}
