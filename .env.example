# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Database ---
# Postgres connection string. On Render, this is provided automatically.
# If using docker-compose.yml, port is 5433 to avoid clashing with any host-installed Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5433/tuktrack

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-plus-char-random-string-generated-by-openssl
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- CORS ---
# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*
