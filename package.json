{
  "name": "tuk-track-api",
  "version": "0.1.0",
  "private": true,
  "description": "RESTful API for real-time three-wheeler tracking and movement logging — Sri Lanka Police (NB6007CEM coursework).",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" \"tests/**/*.js\" --fix",
    "format": "prettier --write \"**/*.{js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,yml}\"",
    "test": "NODE_ENV=test JWT_SECRET=test-secret-only-for-ci-do-not-use-in-prod-32chars LOG_LEVEL=silent node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "NODE_ENV=test JWT_SECRET=test-secret-only-for-ci-do-not-use-in-prod-32chars LOG_LEVEL=silent node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "seed:force": "SEED_FORCE=1 knex seed:run",
    "db:reset": "knex migrate:rollback --all && knex migrate:latest && SEED_FORCE=1 knex seed:run"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/setup/global-setup.js",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transform": {}
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  }
}
